{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Fabio662/yieldagentx402",
  "description": "Authenticated stdio wrapper for the public YieldAgentX402 MCP endpoint.",
  "repository": {
    "url": "https://github.com/Fabio662/Yieldagenticx402-Hub",
    "source": "github",
    "subfolder": "integrations/mcp-server"
  },
  "websiteUrl": "https://yieldagentx402.app/mcp-server",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "agentx402-mcp-server",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "YAX_API_KEY",
          "description": "YieldAgentX402 API key from https://yieldagentx402.app/apply",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "YAX_AGENT_ID",
          "description": "Your agent ID from the dashboard.",
          "format": "string",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "YAX_MCP_ENDPOINT",
          "description": "Optional full MCP endpoint override (default: https://api.yieldagentx402.app/mcp).",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
